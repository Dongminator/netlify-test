<%- include('partials/header') %>
<% const isAdmin = user && user.role === 'ADMIN'; %>
<%# Start and end are stored as 'YYYY-MM-DDTHH:MM', so both halves are slices:
    the date is rendered m/dd/yy (the club's display format everywhere) and the
    clock is taken as-is. The end repeats its date only when the event runs past
    midnight — otherwise "6/13/26 16:00 - 18:00" says it. %>
<% const clock = at => at.slice(11, 16); %>
<% const mdy = at => Number(at.slice(5, 7)) + '/' + at.slice(8, 10) + '/' + at.slice(2, 4); %>
<% const whenLabel = mdy(event.startAt) + ' ' + clock(event.startAt) + ' - '
     + (event.endDate === event.date ? '' : mdy(event.endAt) + ' ') + clock(event.endAt); %>
<div class="pb-2 mt-2 mb-4 border-bottom">
  <h3 class="mb-0"><%= event.title %>
    <% if (isPast) { %><span class="badge badge-secondary">已结束</span><% } %>
    <%# Non-null only when the event is restricted — and only somebody allowed to
        see it ever reaches this page, so the badge says who it is limited to
        rather than that it is hidden. %>
    <% if (visibilityNote) { %>
      <span class="badge badge-warning"><i class="fas fa-lock mr-1" aria-hidden="true"></i><%= visibilityNote %></span>
    <% } %>
  </h3>
</div>

<% if (joinedWaitlist) { %>
  <%# Raised by the ?joined=waitlist redirect from POST /event/:id/signup — the
      event was full, so the signup was recorded as a waitlist one instead. %>
  <div class="alert alert-warning" role="alert">
    活动名额已满，你已加入<strong>候补名单</strong><% if (myPlace) { %>（第 <%= myPlace %> 位）<% } %>。
    有人取消报名时会按报名先后自动补位。
  </div>
<% } %>

<div class="row">
  <div class="col-md-8">
    <table class="table table-sm table-borderless">
      <tr><th class="text-nowrap" style="width:6rem">时间</th><td><%= whenLabel %></td></tr>
      <tr><th>地点</th><td><%= event.location %></td></tr>
      <tr><th>说明</th><td><%= event.description %></td></tr>
    </table>

    <% if (!isPast && signedUp && event.coords) { %>
      <div class="mb-4">
        <% if (checkedIn) { %>
          <span class="badge badge-success p-2">✓ 已到场签到<% if (myCheckinAt) { %> · <%= myCheckinAt %><% } %></span>
        <% } else { %>
          <div id="field-map" class="rounded border mb-2" style="height: 260px;"></div>
          <div id="position-status" class="mb-3 text-muted">正在获取你的位置…</div>
          <%# The button and the reason it is disabled sit on one row from `sm`
              up and stack on a phone. Both halves are rewritten by the script on
              every countdown tick and every position fix — what is rendered here
              is only the state at page load, so the row never appears empty. %>
          <div class="checkin-action">
            <button class="btn btn-success btn-checkin" id="checkin-btn" type="button" disabled>📍 到场签到</button>
            <div class="checkin-hint" id="checkin-hint">
              <% if (serverNow < checkinOpensAt) { %>
                签到将在活动开始前 1 小时开放
              <% } else { %>
                正在获取你的位置…
              <% } %>
            </div>
          </div>
          <div id="checkin-msg" class="mt-2"></div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="col-md-4">
    <%# The roster is an avatar grid, like the production app: gravatar over the
        member's name, wrapping to as many rows as it takes. A check-in shows as a
        green ring plus a tick badge rather than its own row-level label. It sits
        in the open, with no card around it — the border and its padding cost a
        column of avatars in this narrow sidebar. %>
    <%# The tooltip is where the timestamps live: the grid has room for a name and
        nothing else, but every signup and check-in now carries its own time. %>
    <% const rosterTitle = p => p.name
         + (p.position ? ' · ' + p.position : '')
         + (p.signedUpAt ? '\n报名：' + p.signedUpAt : '')
         + (p.checkedInAt ? '\n签到：' + p.checkedInAt : ''); %>
    <div class="roster-block mb-4">
      <div class="roster-head">已报名人数：<%= participants.length %> / <%= event.capacity %></div>
      <% if (participants.length === 0) { %>
        <p class="text-muted mb-0">还没有人报名</p>
      <% } else { %>
        <ul class="roster">
          <% participants.forEach(p => { %>
            <li class="roster-item" title="<%= rosterTitle(p) %>">
              <span class="roster-avatar<%= p.checkedIn ? ' is-checked-in' : '' %>">
                <img src="<%= p.avatar %>" alt="" width="48" height="48" loading="lazy">
                <% if (p.checkedIn) { %>
                  <i class="fas fa-check roster-tick" aria-hidden="true"></i>
                  <span class="sr-only">已签到</span>
                <% } %>
              </span>
              <span class="roster-name"><%= p.name %></span>
            </li>
          <% }) %>
        </ul>
        <% if (participants.some(p => p.checkedIn)) { %>
          <p class="roster-legend mb-0">
            <i class="fas fa-check" aria-hidden="true"></i> 已到场签到
          </p>
        <% } %>
      <% } %>
    </div>

    <%# The waitlist, in the order it will be served. Same grid as the roster
        above so the two read as one list, but the avatars are dimmed and the
        tick badge is replaced by the member's place in the queue. Rendered only
        when somebody is actually waiting. %>
    <% if (waitlist.length) { %>
      <div class="roster-block roster-block-waitlist mb-4">
        <div class="roster-head">候补名单：<%= waitlist.length %> 人</div>
        <ul class="roster">
          <% waitlist.forEach(p => { %>
            <li class="roster-item" title="<%= rosterTitle(p) %>">
              <span class="roster-avatar is-waitlisted">
                <img src="<%= p.avatar %>" alt="" width="48" height="48" loading="lazy">
                <span class="roster-queue"><%= p.place %></span>
                <span class="sr-only">候补第 <%= p.place %> 位</span>
              </span>
              <span class="roster-name"><%= p.name %></span>
            </li>
          <% }) %>
        </ul>
        <p class="roster-legend mb-0">数字为候补顺序，有人取消报名时按此顺序自动补位。</p>
      </div>
    <% } %>
  </div>
</div>

<%# One stacked list of actions, divider-separated: the member's own signup
    button first, then the admin-only ones. It lives under the whole row, below
    the roster, so the buttons are the last thing on the page in either layout.
    Buttons go full-width on a phone. %>
<div class="event-actions">
  <% if (!isPast) { %>
    <% if (signedUp) { %>
      <div class="event-action">
        <form method="POST" action="/event/<%= event.id %>/withdraw">
          <button class="btn btn-outline-danger btn-action" type="submit">取消报名</button>
        </form>
        <span class="text-success event-action-note">
          ✓ 你已报名<% if (checkedIn && myCheckinAt) { %>，<%= myCheckinAt %> 已签到<% } %>
        </span>
      </div>
    <% } else if (waitlisted) { %>
      <%# Leaving the waitlist is the same POST as leaving the roster — the route
          deletes whichever kind of signup you hold. %>
      <div class="event-action">
        <form method="POST" action="/event/<%= event.id %>/withdraw">
          <button class="btn btn-outline-danger btn-action" type="submit">退出候补</button>
        </form>
        <span class="text-warning event-action-note">⏳ 你在候补名单第 <%= myPlace %> 位</span>
      </div>
    <% } else if (participants.length >= event.capacity) { %>
      <div class="event-action">
        <form method="POST" action="/event/<%= event.id %>/signup">
          <button class="btn btn-warning btn-action" type="submit">加入候补名单</button>
        </form>
        <span class="event-action-note text-muted">名额已满，有人取消时自动补位</span>
      </div>
    <% } else { %>
      <div class="event-action">
        <form method="POST" action="/event/<%= event.id %>/signup">
          <button class="btn btn-success btn-action" type="submit">报名</button>
        </form>
      </div>
    <% } %>
  <% } %>

  <% if (isAdmin) { %>
    <%# Both open the one event modal; `data-event-modal` tells it whether to PUT
        this event or POST a copy of it (prefilled, dated a week on). %>
    <div class="event-action">
      <button class="btn btn-brand btn-action" type="button"
              data-event-modal="edit" data-toggle="modal" data-target="#event-modal">
        <i class="fas fa-pen mr-1" aria-hidden="true"></i>编辑活动
      </button>
    </div>
    <div class="event-action">
      <form method="POST" action="/event/<%= event.id %>/clear-signups"
            onsubmit="return confirm('确定清空本次活动的全部报名和签到吗？此操作无法撤销。');">
        <button class="btn btn-danger btn-action" type="submit">
          <i class="fas fa-trash mr-1" aria-hidden="true"></i>清空报名
        </button>
      </form>
    </div>
    <div class="event-action">
      <button class="btn btn-brand btn-action" type="button"
              data-event-modal="copy" data-toggle="modal" data-target="#event-modal">
        <i class="fas fa-plus mr-1" aria-hidden="true"></i>复制
      </button>
    </div>
    <%# Deleting takes the roster with it, so it is confirmed in a modal rather
        than the inline confirm() 清空报名 uses: on a phone a native dialog is a
        one-line question with no room to spell out what is lost. The modal *is*
        the confirmation — its 确认删除 button submits the form it contains, so
        no arming step and no script. %>
    <div class="event-action">
      <button class="btn btn-outline-danger btn-action" type="button"
              data-toggle="modal" data-target="#delete-event-modal">
        <i class="fas fa-trash mr-1" aria-hidden="true"></i>删除活动
      </button>
    </div>
  <% } %>
</div>

<% if (isAdmin) { %>
  <%- include('partials/event-modal', { formEvent: event, defaultDate: event.date }) %>

  <div class="modal fade" id="delete-event-modal" tabindex="-1" role="dialog"
       aria-labelledby="delete-event-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="delete-event-title">删除活动</h5>
          <button class="close" type="button" data-dismiss="modal" aria-label="关闭">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p class="mb-2">确定删除活动<strong>「<%= event.title %>」</strong>（<%= whenLabel %>）吗？</p>
          <div class="alert alert-danger mb-0" role="alert">
            该活动的全部报名、候补名单和签到记录都会一并删除，此操作无法撤销。
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
          <%# Admin-only route: requireAdmin re-reads the role, the `isAdmin`
              local above only decides what renders. %>
          <form method="POST" action="/event/<%= event.id %>/delete">
            <button class="btn btn-danger" type="submit">确认删除</button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (signedUp && !checkedIn && !isPast && event.coords) { %>
<script>
  (function () {
    var FIELD = { lat: <%= event.coords.lat %>, lng: <%= event.coords.lng %> };
    var RADIUS = <%= event.checkinRadius %>;
    var btn = document.getElementById('checkin-btn');
    var msg = document.getElementById('checkin-msg');
    var status = document.getElementById('position-status');
    var hint = document.getElementById('checkin-hint');
    var lastPos = null;
    var lastFixAt = 0;      // when that fix landed, on the corrected clock
    var watchId = null;     // the live watchPosition registration, if any
    var userMarker = null;
    var accuracyCircle = null;

    // The gates on the button: the check-in window opens an hour before kick-off
    // and closes when the event ends, and the member has to be inside the
    // field's radius. `OPENS_AT`/`CLOSES_AT` are the same absolute instants the
    // route checks, and the clock they are compared against is the server's — a
    // phone running a few minutes fast would otherwise enable a button the route
    // refuses. Either may be NaN if the stored time is malformed, which every
    // comparison below falls back through to distance alone.
    var OPENS_AT = <%= checkinOpensAt %>;
    var CLOSES_AT = <%= checkinClosesAt %>;
    var SKEW = <%= serverNow %> - Date.now();
    var LABEL = '📍 到场签到';
    var inside = null;      // null until the first position fix lands
    var locError = '';      // set when there will be no fix at all
    var submitting = false; // a POST is in flight; the ticker must not undo it
    var ticker = null;      // 1s countdown, alive only until the window opens
    var closeTimer = null;  // one-shot, fires when the window closes

    function now() { return Date.now() + SKEW; }
    function pad(n) { return n < 10 ? '0' + n : String(n); }

    // The countdown is driven by a self-rescheduling timeout, not setInterval:
    // each tick aims at the next whole second of the *corrected* clock and reads
    // the time afresh, so a phone that froze the page for ten minutes in the
    // background resumes on the right second instead of resuming ten minutes'
    // worth of missed ticks behind. (Chrome on Android throttles background
    // timers to roughly one a minute, and stops them altogether once the tab has
    // been hidden for a few minutes — which is exactly the lag being fixed.)
    function stopTicker() {
      if (ticker) { clearTimeout(ticker); ticker = null; }
    }

    function tick() {
      ticker = null;
      render();
      startTicker();
    }

    function startTicker() {
      if (ticker || !(now() < OPENS_AT)) return;
      ticker = setTimeout(tick, 1000 - (now() % 1000));
    }

    // Once the window is open the countdown has nothing left to do, but the
    // *close* is still ahead: this is what takes the button away the moment the
    // event ends, rather than leaving one the route answers 400 to.
    function armCloseTimer() {
      if (closeTimer || !isFinite(CLOSES_AT)) return;
      var left = CLOSES_AT - now();
      if (left <= 0) return;
      closeTimer = setTimeout(function () { closeTimer = null; render(); }, left + 250);
    }

    function countdown(ms) {
      var total = Math.max(0, Math.ceil(ms / 1000));
      var hms = pad(Math.floor(total / 3600) % 24) + ':'
        + pad(Math.floor(total / 60) % 60) + ':' + pad(total % 60);
      var days = Math.floor(total / 86400);
      return days ? days + ' 天 ' + hms : hms;
    }

    // Single source of truth for the button: called on every tick, every
    // position fix and after a failed submit, never from two places at once.
    function render() {
      if (submitting) return;
      var t = now();
      if (isFinite(CLOSES_AT) && t >= CLOSES_AT) {
        stopTicker();
        btn.disabled = true;
        btn.classList.remove('is-ready');
        hint.className = 'checkin-hint text-muted';
        hint.textContent = '活动已结束，签到已关闭';
        return;
      }
      var left = OPENS_AT - t;
      if (left > 0) {
        btn.disabled = true;
        btn.classList.remove('is-ready');
        hint.className = 'checkin-hint';
        hint.innerHTML = '签到将在活动开始前 1 小时开放 · 还有 '
          + '<span class="checkin-countdown">' + countdown(left) + '</span>';
        return;
      }
      // Open from here on, so the countdown has nothing left to do — position
      // fixes drive the rest, until the close timer takes the button away.
      stopTicker();
      armCloseTimer();
      if (locError) {
        btn.disabled = true;
        btn.classList.remove('is-ready');
        hint.className = 'checkin-hint text-danger';
        hint.textContent = locError;
        return;
      }
      var ready = inside === true;
      btn.disabled = !ready;
      btn.classList.toggle('is-ready', ready);
      hint.className = 'checkin-hint' + (ready ? ' is-ready' : '');
      hint.textContent = ready ? '✓ 你已到达球场，现在可以签到'
        : inside === null ? '正在获取你的位置…'
        : '到达球场后即可签到';
    }

    var map = L.map('field-map').setView([FIELD.lat, FIELD.lng], 17);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    L.marker([FIELD.lat, FIELD.lng]).addTo(map).bindPopup('⚽ 球场签到点');
    var boundary = L.circle([FIELD.lat, FIELD.lng], {
      radius: RADIUS, color: '#28a745', fillColor: '#28a745', fillOpacity: 0.15
    }).addTo(map);
    map.fitBounds(boundary.getBounds(), { maxZoom: 19, padding: [20, 20] });

    function distanceMeters(lat1, lng1, lat2, lng2) {
      var R = 6371000, toRad = function (d) { return d * Math.PI / 180; };
      var dLat = toRad(lat2 - lat1), dLng = toRad(lng2 - lng1);
      var a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
        + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return 2 * R * Math.asin(Math.sqrt(a));
    }

    function show(text, ok) {
      msg.innerHTML = '<div class="alert alert-' + (ok ? 'success' : 'danger') + ' py-2 mb-0">' + text + '</div>';
    }

    function onPosition(pos) {
      lastPos = pos;
      lastFixAt = now();
      var lat = pos.coords.latitude, lng = pos.coords.longitude;
      if (!userMarker) {
        userMarker = L.circleMarker([lat, lng], {
          radius: 7, color: '#fff', weight: 2, fillColor: '#007bff', fillOpacity: 1
        }).addTo(map).bindPopup('你的位置');
        accuracyCircle = L.circle([lat, lng], {
          radius: pos.coords.accuracy, color: '#007bff', weight: 1, fillOpacity: 0.08
        }).addTo(map);
        map.fitBounds(L.latLngBounds([[lat, lng], [FIELD.lat, FIELD.lng]]).pad(0.3), { maxZoom: 19 });
      } else {
        userMarker.setLatLng([lat, lng]);
        accuracyCircle.setLatLng([lat, lng]).setRadius(pos.coords.accuracy);
      }
      var d = Math.round(distanceMeters(lat, lng, FIELD.lat, FIELD.lng));
      inside = d <= RADIUS;
      locError = '';
      // The line under the map is the distance readout; whether the button is
      // usable, and why, is the hint beside it.
      status.className = 'mb-3 ' + (inside ? 'text-success font-weight-bold' : 'text-muted');
      status.textContent = inside
        ? '✓ 已进入签到范围（距中心 ' + d + ' 米）'
        : '距签到点 ' + d + ' 米，进入绿圈后可签到（定位精度 ±' + Math.round(pos.coords.accuracy) + ' 米）';
      render();
    }

    function onPositionError(err) {
      status.textContent = '无法获取位置：' + err.message + '（请允许定位权限后刷新页面）';
      status.className = 'mb-3 text-danger';
      // Only fatal while nothing has been received: a dropped fix mid-session
      // leaves the last known state alone rather than pulling the button.
      if (inside === null) {
        locError = '无法获取位置，请允许定位权限后刷新页面';
        render();
      }
    }

    var GEO_OPTS = { enableHighAccuracy: true, timeout: 15000, maximumAge: 5000 };

    function startWatch() {
      if (!navigator.geolocation || watchId !== null) return;
      watchId = navigator.geolocation.watchPosition(onPosition, onPositionError, GEO_OPTS);
    }

    // A watch that survived a spell in the background often survives it *silently* —
    // still registered, no longer delivering. Tearing it down and starting a new
    // one is the only reliable way to know it is live again.
    function restartWatch() {
      if (!navigator.geolocation) return;
      if (watchId !== null) { navigator.geolocation.clearWatch(watchId); watchId = null; }
      startWatch();
    }

    // One fix, right now, bypassing any cached one. Its failures are ignored on
    // purpose: this runs alongside the watch, whose error handler already owns
    // the message, and a single timed-out poll must not blank a good fix.
    function refreshPosition() {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(onPosition, function () {}, {
        enableHighAccuracy: true, timeout: 15000, maximumAge: 0
      });
    }

    // The backup source. `watchPosition` is the primary one, but it is exactly
    // what a phone stops servicing while the member is in another app — so
    // whenever the page is on screen and the newest fix is older than
    // POSITION_MAX_AGE_MS, one is asked for outright. This is what turns the
    // button on when somebody walks into the circle after switching back, rather
    // than waiting for a watch that may never fire again.
    var POSITION_MAX_AGE_MS = 20000;
    setInterval(function () {
      if (document.hidden || locError) return;
      if (now() - lastFixAt >= POSITION_MAX_AGE_MS) refreshPosition();
    }, POSITION_MAX_AGE_MS / 2);

    // The page is in front of the member again. Nothing on screen is trusted
    // after a return from the background: the countdown is re-read from the
    // clock rather than resumed, the ticker restarted, the watch rebuilt and a
    // fresh fix requested at once — so both gates are re-evaluated immediately
    // instead of whenever the phone gets round to the next timer or fix.
    // Seeded to now so the `pageshow` that fires on this very load doesn't tear
    // down the watch started just below it.
    var lastResync = Date.now();
    function resync() {
      if (document.hidden) return;
      render();
      startTicker();
      // `focus` and `visibilitychange` both fire on the way back to a tab; one
      // watch rebuild between them is enough.
      if (Date.now() - lastResync < 1000) return;
      lastResync = Date.now();
      restartWatch();
      refreshPosition();
    }

    document.addEventListener('visibilitychange', resync);
    window.addEventListener('pageshow', resync);
    window.addEventListener('focus', resync);
    // A phone that was offline may have had its fixes fail rather than lag.
    window.addEventListener('online', resync);

    if (!navigator.geolocation) {
      locError = '当前浏览器不支持定位，无法签到';
      status.textContent = locError;
      status.className = 'mb-3 text-danger';
    } else {
      startWatch();
    }

    render();
    startTicker();

    btn.addEventListener('click', function () {
      if (!lastPos || btn.disabled) return;
      submitting = true;
      btn.disabled = true;
      btn.classList.remove('is-ready');
      btn.textContent = '签到中…';
      fetch('/event/<%= event.id %>/checkin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lat: lastPos.coords.latitude,
          lng: lastPos.coords.longitude
        })
      }).then(function (r) {
        return r.json().then(function (data) {
          show(data.message, data.ok);
          if (data.ok) {
            setTimeout(function () { location.reload(); }, 1200);
          } else {
            submitting = false;
            btn.textContent = LABEL;
            render();
          }
        });
      }).catch(function () {
        show('网络错误，请重试', false);
        submitting = false;
        btn.textContent = LABEL;
        render();
      });
    });
  })();
</script>
<% } %>
<%- include('partials/footer') %>
